# Server Port
PORT=5001

# Default Country Code (Primary Focus: in for India, or us, gb, etc.)
COUNTRY_CODE=in

# NewsAPI.org API Key (Get a free key from https://newsapi.org/register)
NEWS_API_KEY=your_newsapi_org_key_here

# NewsData.io API Key (Secondary provider for Indian news - https://newsdata.io/register)
NEWSDATA_API_KEY=your_newsdata_io_key_here

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=real_news_db

# JSON Web Token Secret Key
JWT_SECRET=your_jwt_secret_key_here

# Frontend Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Background News Refresh Interval in Minutes (Default: 60 for NewsAPI free-tier safeguard)
REFRESH_INTERVAL_MINUTES=60
